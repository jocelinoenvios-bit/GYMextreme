rules_version = '2';

// Regras para os Modulos 1 (login + perfil), 2 (cadastro/ficha do aluno) e
// o sistema de cargos/permissoes (gestao de funcionarios).
// Aplique em Firebase Console > Firestore Database > Regras, ou via
// `firebase deploy --only firestore:rules` depois de rodar `firebase init`.
service cloud.firestore {
  match /databases/{database}/documents {

    function ehStaff() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['adm', 'personal', 'funcionario'];
    }

    function ehAdm() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'adm';
    }

    // ADM sempre tem a permissao; funcionario/personal so se `perm` estiver
    // na lista `permissoes` do proprio documento (`.get(..., [])` evita erro
    // em contas legadas que ainda nao tem esse campo). Exige `ehStaff()`
    // além de checar a lista — blindagem pra um aluno nunca conseguir
    // acesso mesmo que o campo `permissoes` do documento dele seja
    // corrompido/preenchido por engano.
    function temPermissao(perm) {
      return ehAdm() || (
        ehStaff() &&
        perm in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('permissoes', [])
      );
    }

    match /usuarios/{uid} {
      // Qualquer usuario autenticado pode ler o PROPRIO documento
      // (e o que a tela de boas-vindas usa para saber o "role").
      // Staff tambem pode ler a lista de alunos/funcionarios.
      allow read: if request.auth != null && (request.auth.uid == uid || ehStaff());

      // Cadastrar um aluno continua liberado pra qualquer staff (fluxo de
      // "novo aluno" do Modulo 2). Cadastrar outro membro da equipe
      // (ADM/funcionario) exige a permissao "gerenciarFuncionarios".
      allow create: if ehStaff() &&
        (request.resource.data.role == 'aluno' || temPermissao('gerenciarFuncionarios'));

      // Editar/apagar o documento de outra pessoa (ex.: ajustar permissoes
      // de um funcionario) exige "gerenciarFuncionarios".
      allow update, delete: if temPermissao('gerenciarFuncionarios');
    }

    match /cargos/{cargoId} {
      // Qualquer staff pode ver os cargos customizados (ex.: dropdown na
      // tela de novo funcionario). So quem gerencia funcionarios cria/edita.
      allow read: if ehStaff();
      allow write: if temPermissao('gerenciarFuncionarios');
    }

    match /alunos/{uid} {
      // O proprio aluno pode ler a propria ficha; ADM/Personal leem e
      // escrevem a ficha de qualquer aluno (cadastro, anamnese, termo).
      allow read: if request.auth != null && (request.auth.uid == uid || ehStaff());
      allow write: if ehStaff();

      match /avaliacoes/{avaliacaoId} {
        allow read: if request.auth != null && (request.auth.uid == uid || ehStaff());
        allow write: if ehStaff();
      }

      // Historico de pagamentos de mensalidade — so quem tem a permissao
      // especifica de receber mensalidade pode registrar (nao basta ser
      // staff generico); o proprio aluno so le, nunca escreve.
      match /pagamentos/{pagamentoId} {
        allow read: if request.auth != null && (request.auth.uid == uid || ehStaff());
        allow write: if temPermissao('receberMensalidades');
      }

      // Fichas de treino: o proprio aluno le a propria (pra ver o treino
      // do dia); staff le qualquer uma; escrever exige a permissao
      // especifica de treino (nao basta ser staff generico).
      match /treinos/{treinoId} {
        allow read: if request.auth != null && (request.auth.uid == uid || ehStaff());
        allow write: if temPermissao('criarTreinos') || temPermissao('editarTreinos');
      }
    }

    // Controle de acesso da catraca (identificacao, autorizacao e
    // acionamento desacoplados — ver functions/README.md). Estas colecoes
    // so sao criadas pela Cloud Function `solicitarAutorizacaoAcesso`, via
    // Admin SDK (que ignora estas regras) — o app cliente nunca escreve.
    match /credenciais/{credencialId} {
      allow read: if ehStaff();
      allow write: if false;
    }

    match /academias/{academiaId} {
      allow read: if ehStaff();
      allow write: if false;

      // O servico local (rodando no computador da academia) le esta fila
      // autenticado como uma conta de staff dedicada, sem permissoes de
      // tela nenhuma — so precisa passar em `ehStaff()`. So pode marcar
      // uma autorizacao como consumida depois de acionar (ou nao) o
      // solenoide — nunca cria uma autorizacao nem altera se foi
      // aprovada, isso e responsabilidade exclusiva da Cloud Function.
      match /autorizacoesAcesso/{autorizacaoId} {
        allow read: if ehStaff();
        allow create: if false;
        allow update: if ehStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumida', 'processadoEm']);
        allow delete: if false;
      }
    }

    match /exercicios/{exercicioId} {
      // Biblioteca de referencia, sem dado sensivel — qualquer usuario
      // autenticado pode ler (inclusive aluno, pra ver o proprio treino
      // com nome/gif/instrucoes do exercicio). Cadastro continua fora do
      // app (script/import direto no Firestore com credencial de admin).
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
