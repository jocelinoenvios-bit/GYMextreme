# Copie para ".env" e preencha antes de rodar "npm start".
# Nunca commite o ".env" de verdade (ja esta no .gitignore).

# Config do projeto Firebase — os mesmos valores publicos de
# lib/firebase_options.dart (nao sao segredo, so identificam o projeto).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Conta de staff dedicada pra este serviço (criada pela tela "Gerenciar
# funcionários", cargo Recepcionista ou similar — so precisa passar em
# ehStaff(), nao usa nenhuma tela do app). Nunca reaproveite a conta de
# um funcionario de verdade aqui.
CATRACA_EMAIL=
CATRACA_SENHA=

# Id da academia (coincide com o documento em `academias/{id}`).
CATRACA_ACADEMIA_ID=academia_principal
