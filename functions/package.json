{
  "name": "gymextreme-functions",
  "description": "Cloud Functions do GYM XTREME: autorizacao de acesso da catraca e notificacoes automaticas de mensalidade.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "test": "node --test test/",
    "test:emulator": "firebase emulators:exec --project demo-gymextreme-test --only firestore \"node test/notificacao-mensalidade.emulator.js\"",
    "test:rules": "firebase emulators:exec --project demo-gymextreme-test --only firestore \"node test/firestore-rules-admin.emulator.js\"",
    "test:emulator:access": "firebase emulators:exec --project demo-gymextreme-test --only firestore \"node test/access/controlid-new-user-identified.emulator.js && node test/access/device-sync-service.emulator.js && node test/access/offline-access-policy.emulator.js\"",
    "test:rules:access": "firebase emulators:exec --project demo-gymextreme-test --only firestore \"node test/access/firestore-rules-access.emulator.js\"",
    "test:audit": "firebase emulators:exec --project demo-gymextreme-test --only firestore \"node test/access/auditoria-fluxo-completo.emulator.js\"",
    "mock:idface": "firebase emulators:exec --project demo-gymextreme-test --only firestore \"node scripts/mock-idface.js\"",
    "upload:gifs": "node scripts/upload-gifs-storage.js",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1"
  }
}
